<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <model name="north_wall">
      <static>true</static><pose>0 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 0.08 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 0.08 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 0.08 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 0.08 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>1.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.08 4 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.08 4 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-1.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.08 4 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.08 4 1</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
