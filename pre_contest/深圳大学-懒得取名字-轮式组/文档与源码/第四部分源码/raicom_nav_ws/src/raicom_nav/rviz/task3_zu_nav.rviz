Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Cell Size: 0.5
      Class: rviz/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Value: true
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/LaserScan
      Color: 255; 255; 255
      Enabled: true
      Name: Scan
      Size (m): 0.03
      Style: Points
      Topic: /scan
      Unreliable: false
      Value: true
    - Class: rviz/Path
      Color: 25; 255; 40
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: ActualPath
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Color: 25; 255; 40
      Pose Style: None
      Topic: /zu_actual_path
      Unreliable: false
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /zu_reference_marker
      Name: ZuReference
      Namespaces:
        zu_reference: true
      Queue Size: 100
      Value: true
    - Class: rviz/Path
      Color: 255; 120; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: GlobalPlan
      Offset:
        X: 0
        Y: 0
        Z: 0.02
      Pose Color: 255; 120; 0
      Pose Style: None
      Topic: /move_base/GlobalPlanner/plan
      Unreliable: false
      Value: true
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 28; 28; 28
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: TopDownOrtho
      Scale: 30
      Target Frame: map
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
