# 跨平台行尾标准化，避免 CRLF/LF 冲突。
# 默认：文本文件在仓库中以 LF 存储。
* text=auto eol=lf

# 仓库元数据和文档。
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.markdown text eol=lf
LICENSE text eol=lf

# 脚本和 ROS/Linux 面向文件：在 Windows 和 Ubuntu 间保持 LF。
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.launch text eol=lf
*.msg text eol=lf
*.srv text eol=lf
*.service text eol=lf
*.urdf text eol=lf
*.xacro text eol=lf
*.rviz text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
package.xml text eol=lf

# Windows 脚本文件保留 CRLF。
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 通用二进制 / 运行时产物，禁止换行转换。
