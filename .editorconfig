root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,sh,bash,zsh}]
indent_size = 4

[*.{cpp,h,hpp,c,cc}]
indent_size = 2

[*.{yaml,yml,launch,xml,md,markdown,rviz}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4
